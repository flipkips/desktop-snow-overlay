#pragma code_page(65001)
#include <windows.h>

#define IDI_APP 101

IDI_APP ICON "snow.ico"
CREATEPROCESS_MANIFEST_RESOURCE_ID RT_MANIFEST "app.manifest"

VS_VERSION_INFO VERSIONINFO
FILEVERSION 1,0,0,0
PRODUCTVERSION 1,0,0,0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "FileDescription", "LayerSnow"
            VALUE "CompanyName", "flipkips"
            VALUE "LegalCopyright", "Copyright (c) 2026 flipkips. MIT License"
            VALUE "FileVersion", "1.0.0"
            VALUE "ProductName", "LayerSnow"
            VALUE "ProductVersion", "1.0.0"
            VALUE "OriginalFilename", "LayerSnow-Setup.exe"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
